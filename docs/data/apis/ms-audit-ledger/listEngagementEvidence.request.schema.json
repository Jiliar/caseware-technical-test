{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-audit-ledger/listEngagementEvidence.request.schema.json",
  "title": "listEngagementEvidence request",
  "description": "GET /v1/evidence/engagements/{engagementId} - request. Audit trail of one engagement in a date range: summary views, decisions and offer lifecycle (paginated).",
  "$comment": "Source: DISENO S6 (b) AuditEntry/SummaryProvenance, (c) AP-L1/AP-L2, (d) ReconstructSummaryEvidenceQuery, (e) compliance APIs, (k); PRD RF-048, RF-068, RNF-025; US-05.3.2. Audience: OPERATOR (operator console / role-restricted). Residency: REGIONAL (cell; regional WORM); read access is audited and role-restricted (compliance). Idempotency: safe read (GET); the read itself is audited. Pagination: cursor + limit <= N_pagemax (DISENO 3.6 (e), 3.8.5).",
  "type": "object",
  "properties": {
    "method": {
      "const": "GET",
      "description": "HTTP method."
    },
    "path": {
      "const": "/v1/evidence/engagements/{engagementId}",
      "description": "Path template (versioned /v1)."
    },
    "headers": {
      "type": "object",
      "description": "Contract-relevant request headers (platform/transport headers are out of scope). correlation-id is optional from the UI (generated by ms-experience-gateway when missing, DISENO 3.8.5) and mandatory on service-to-service and operator calls (propagation, RF-120).",
      "properties": {
        "correlation-id": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
        },
        "traceparent": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/traceparent"
        },
        "accept": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/acceptJson"
        }
      },
      "required": [
        "correlation-id"
      ],
      "additionalProperties": false
    },
    "pathParams": {
      "type": "object",
      "description": "Path parameters.",
      "properties": {
        "engagementId": {
          "type": "string",
          "format": "uuid",
          "description": "Engagement id."
        }
      },
      "required": [
        "engagementId"
      ],
      "additionalProperties": false
    },
    "queryParams": {
      "type": "object",
      "description": "Query parameters (exactly as documented; unknown parameters are rejected with 400).",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "Range start (inclusive, occurredAt)."
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "description": "Range end (exclusive, occurredAt)."
        },
        "cursor": {
          "$ref": "../_shared/pagination.schema.json#/$defs/cursor"
        },
        "limit": {
          "$ref": "../_shared/pagination.schema.json#/$defs/limit"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "method",
    "path",
    "headers",
    "pathParams",
    "queryParams"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "method": "GET",
      "path": "/v1/evidence/engagements/{engagementId}",
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
        "accept": "application/json"
      },
      "pathParams": {
        "engagementId": "11111111-1111-4111-8111-111111111111"
      },
      "queryParams": {
        "from": "2026-10-01T00:00:00Z",
        "to": "2026-11-01T00:00:00Z",
        "limit": 100
      }
    }
  ]
}
