{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-audit-ledger/getSummaryEvidence.response.schema.json",
  "title": "getSummaryEvidence response",
  "description": "GET /v1/evidence/summaries/{summaryId} - responses per status code. Evidence of a summary in this cell: provenance plus who viewed it and who decided with it (paginated).",
  "$comment": "Source: DISENO S6 (b) AuditEntry/SummaryProvenance, (c) AP-L1/AP-L2, (d) ReconstructSummaryEvidenceQuery, (e) compliance APIs, (k); PRD RF-048, RF-068, RNF-025; US-05.3.2. Audience: OPERATOR (operator console / role-restricted). Residency: REGIONAL (cell; regional WORM); read access is audited and role-restricted (compliance). Idempotency: safe read (GET); the read itself is audited. Pagination: cursor + limit <= N_pagemax (DISENO 3.6 (e), 3.8.5).",
  "type": "object",
  "properties": {
    "status": {
      "type": "integer",
      "enum": [
        200,
        400,
        404
      ],
      "description": "HTTP status."
    },
    "headers": {
      "type": "object",
      "description": "Response headers (see the per-status subschema)."
    },
    "body": {
      "description": "Response body (see the per-status subschema)."
    }
  },
  "required": [
    "status",
    "headers"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "$ref": "#/$defs/status200"
    },
    {
      "$ref": "#/$defs/status400"
    },
    {
      "$ref": "#/$defs/status404"
    }
  ],
  "$defs": {
    "status200": {
      "type": "object",
      "description": "200: Evidence page.",
      "properties": {
        "status": {
          "const": 200,
          "description": "Evidence page."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeJson"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "description": "Page envelope (_shared/pagination.schema.json).",
          "properties": {
            "summaryId": {
              "type": "string",
              "format": "uuid",
              "description": "Summary id."
            },
            "provenance": {
              "oneOf": [
                {
                  "$ref": "#/$defs/SummaryProvenance"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local provenance; null if EV-05 not yet received."
            },
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/SummaryViewEntry"
                  },
                  {
                    "$ref": "#/$defs/DecisionEntry"
                  }
                ]
              },
              "description": "View and decision entries ordered by occurredAt."
            },
            "nextCursor": {
              "$ref": "../_shared/pagination.schema.json#/$defs/nextCursor"
            }
          },
          "required": [
            "summaryId",
            "provenance",
            "items",
            "nextCursor"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status400": {
      "type": "object",
      "description": "400: Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request).",
      "properties": {
        "status": {
          "const": 400,
          "description": "Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 400
                },
                "type": {
                  "enum": [
                    "invalid-request"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status404": {
      "type": "object",
      "description": "404: Resource not found (problem type not-found).",
      "properties": {
        "status": {
          "const": 404,
          "description": "Resource not found (problem type not-found)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 404
                },
                "type": {
                  "enum": [
                    "not-found"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "SummaryViewEntry": {
      "type": "object",
      "description": "summary_view row.",
      "properties": {
        "entryType": {
          "type": "string",
          "const": "SummaryViewEntry",
          "description": "AuditEntry subtype."
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "Source eventId (EV-28)."
        },
        "summaryId": {
          "type": "string",
          "format": "uuid",
          "description": "Summary id."
        },
        "engagementId": {
          "type": "string",
          "format": "uuid",
          "description": "Engagement id."
        },
        "firmId": {
          "type": "string",
          "format": "uuid",
          "description": "Firm id."
        },
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "Viewer."
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Instant."
        },
        "region": {
          "type": "string",
          "description": "Region/cell.",
          "minLength": 1
        }
      },
      "required": [
        "entryType",
        "eventId",
        "summaryId",
        "engagementId",
        "firmId",
        "userId",
        "occurredAt",
        "region"
      ],
      "additionalProperties": false
    },
    "DecisionEntry": {
      "type": "object",
      "description": "decision row.",
      "properties": {
        "entryType": {
          "type": "string",
          "const": "DecisionEntry",
          "description": "AuditEntry subtype."
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "Source eventId (EV-20)."
        },
        "engagementId": {
          "type": "string",
          "format": "uuid",
          "description": "Engagement id."
        },
        "firmId": {
          "type": "string",
          "format": "uuid",
          "description": "Firm id."
        },
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "Decider."
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPLIED",
            "DECLINED"
          ],
          "description": "Decision (EV-20)."
        },
        "fromVersion": {
          "type": "string",
          "description": "From version label.",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "description": "To version label.",
          "minLength": 1
        },
        "summaryId": {
          "type": "string",
          "format": "uuid",
          "description": "Summary shown."
        },
        "discrepancy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NONE",
            "STALE_OFFER",
            "APPLIED_WITHDRAWN"
          ],
          "description": "Discrepancy (EV-20)."
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Instant."
        },
        "region": {
          "type": "string",
          "description": "Region/cell.",
          "minLength": 1
        }
      },
      "required": [
        "entryType",
        "eventId",
        "engagementId",
        "firmId",
        "userId",
        "decision",
        "fromVersion",
        "toVersion",
        "summaryId",
        "discrepancy",
        "occurredAt",
        "region"
      ],
      "additionalProperties": false
    },
    "SummaryProvenance": {
      "type": "object",
      "description": "SummaryProvenance (DISENO S6 (b)): local non-confidential copy of EV-05.",
      "properties": {
        "summaryId": {
          "type": "string",
          "format": "uuid",
          "description": "Summary id."
        },
        "templateId": {
          "type": "string",
          "format": "uuid",
          "description": "Template id."
        },
        "from": {
          "type": "string",
          "description": "From version label.",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "description": "To version label.",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "description": "Locale.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "DETERMINISTIC",
            "NARRATIVE"
          ],
          "description": "SummaryKind."
        },
        "diffHash": {
          "type": "string",
          "description": "Diff hash.",
          "minLength": 1
        },
        "promptVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "Prompt version."
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model id."
        },
        "outputHash": {
          "type": "string",
          "description": "Output hash.",
          "minLength": 1
        },
        "invalidatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Invalidation instant."
        }
      },
      "required": [
        "summaryId",
        "templateId",
        "from",
        "to",
        "locale",
        "kind",
        "diffHash",
        "promptVersion",
        "modelId",
        "outputHash",
        "invalidatedAt"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "status": 200,
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "content-type": "application/json"
      },
      "body": {
        "summaryId": "55555555-5555-4555-8555-555555555555",
        "provenance": {
          "summaryId": "55555555-5555-4555-8555-555555555555",
          "templateId": "33333333-3333-4333-8333-333333333333",
          "from": "v3",
          "to": "v7",
          "locale": "en-CA",
          "kind": "NARRATIVE",
          "diffHash": "9f2c1e0b7a4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b",
          "promptVersion": "p-2026-10",
          "modelId": "example-model-2026-01-01",
          "outputHash": "0a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9",
          "invalidatedAt": null
        },
        "items": [
          {
            "entryType": "SummaryViewEntry",
            "eventId": "12121212-1212-4121-8121-121212121212",
            "summaryId": "55555555-5555-4555-8555-555555555555",
            "engagementId": "11111111-1111-4111-8111-111111111111",
            "firmId": "22222222-2222-4222-8222-222222222222",
            "userId": "44444444-4444-4444-8444-444444444444",
            "occurredAt": "2026-10-23T08:59:00Z",
            "region": "EU"
          },
          {
            "entryType": "DecisionEntry",
            "eventId": "13131313-1313-4131-8131-131313131313",
            "engagementId": "11111111-1111-4111-8111-111111111111",
            "firmId": "22222222-2222-4222-8222-222222222222",
            "userId": "44444444-4444-4444-8444-444444444444",
            "decision": "APPLIED",
            "fromVersion": "v3",
            "toVersion": "v7",
            "summaryId": "55555555-5555-4555-8555-555555555555",
            "discrepancy": "NONE",
            "occurredAt": "2026-10-23T09:00:00Z",
            "region": "EU"
          }
        ],
        "nextCursor": null
      }
    }
  ]
}
