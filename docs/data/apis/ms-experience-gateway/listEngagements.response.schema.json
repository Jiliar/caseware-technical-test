{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-experience-gateway/listEngagements.response.schema.json",
  "title": "listEngagements response",
  "description": "GET /v1/engagements - responses per status code. Paginated, filterable engagement list of the caller's firm with the at-a-glance indicator; proxies ms-engagement-index listFirmEngagements (SX-01a).",
  "$comment": "Source: DISENO S7 (d) ListEngagementsQuery, (e) 'GET /v1/engagements?... (paginated proxy)', (h); DISENO 4.8 SX-01a; ADR-020; PRD RF-030, RF-033, RF-034, RF-015, RF-037, RF-120, RNF-003, SLO-04. Audience: PUBLIC (served to the UI) - SX-01a caller. Residency: REGIONAL (cell of the firm, resolved by the stateless global edge firmId -> cell, RF-093); the firm comes from the authenticated context, never from the URL. Idempotency: safe read (GET). Pagination: cursor + limit <= N_pagemax; opaque cursor encoding the position per shard (RF-034).",
  "type": "object",
  "properties": {
    "status": {
      "type": "integer",
      "enum": [
        200,
        400,
        503
      ],
      "description": "HTTP status."
    },
    "headers": {
      "type": "object",
      "description": "Response headers (see the per-status subschema)."
    },
    "body": {
      "description": "Response body (see the per-status subschema)."
    }
  },
  "required": [
    "status",
    "headers"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "$ref": "#/$defs/status200"
    },
    {
      "$ref": "#/$defs/status400"
    },
    {
      "$ref": "#/$defs/status503"
    }
  ],
  "$defs": {
    "status200": {
      "type": "object",
      "description": "200: Page of engagements.",
      "properties": {
        "status": {
          "const": 200,
          "description": "Page of engagements."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeJson"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "description": "Page envelope (_shared/pagination.schema.json).",
          "properties": {
            "freshness": {
              "$ref": "../_shared/FreshnessBadge.schema.json"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "../_shared/EngagementListItem.schema.json"
              },
              "description": "Engagements of the page."
            },
            "nextCursor": {
              "$ref": "../_shared/pagination.schema.json#/$defs/nextCursor"
            }
          },
          "required": [
            "freshness",
            "items",
            "nextCursor"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status400": {
      "type": "object",
      "description": "400: Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request).",
      "properties": {
        "status": {
          "const": 400,
          "description": "Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 400
                },
                "type": {
                  "enum": [
                    "invalid-request"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status503": {
      "type": "object",
      "description": "503: Dependency unavailable: honest fallback, never invented state; carries retry-after (problem type dependency-unavailable).",
      "properties": {
        "status": {
          "const": 503,
          "description": "Dependency unavailable: honest fallback, never invented state; carries retry-after (problem type dependency-unavailable)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            },
            "retry-after": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/retryAfter"
            }
          },
          "required": [
            "correlation-id",
            "content-type",
            "retry-after"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 503
                },
                "type": {
                  "enum": [
                    "dependency-unavailable"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "status": 200,
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "content-type": "application/json"
      },
      "body": {
        "freshness": {
          "updatedAt": "2026-10-22T10:00:05Z",
          "notice": "CURRENT"
        },
        "items": [
          {
            "engagementId": "11111111-1111-4111-8111-111111111111",
            "firmId": "22222222-2222-4222-8222-222222222222",
            "templateId": "33333333-3333-4333-8333-333333333333",
            "branch": "main",
            "currentVersion": "v3",
            "classification": "CLASSIFIED",
            "offer": {
              "target": "v7",
              "since": "2026-10-22T10:00:05Z",
              "status": "PENDING",
              "previouslyDeclined": [
                "v5"
              ]
            },
            "flags": [],
            "updatedAt": "2026-10-22T10:00:05Z"
          }
        ],
        "nextCursor": null
      }
    }
  ]
}
