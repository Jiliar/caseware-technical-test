{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-experience-gateway/listEngagements.request.schema.json",
  "title": "listEngagements request",
  "description": "GET /v1/engagements - request. Paginated, filterable engagement list of the caller's firm with the at-a-glance indicator; proxies ms-engagement-index listFirmEngagements (SX-01a).",
  "$comment": "Source: DISENO S7 (d) ListEngagementsQuery, (e) 'GET /v1/engagements?... (paginated proxy)', (h); DISENO 4.8 SX-01a; ADR-020; PRD RF-030, RF-033, RF-034, RF-015, RF-037, RF-120, RNF-003, SLO-04. Audience: PUBLIC (served to the UI) - SX-01a caller. Residency: REGIONAL (cell of the firm, resolved by the stateless global edge firmId -> cell, RF-093); the firm comes from the authenticated context, never from the URL. Idempotency: safe read (GET). Pagination: cursor + limit <= N_pagemax; opaque cursor encoding the position per shard (RF-034).",
  "type": "object",
  "properties": {
    "method": {
      "const": "GET",
      "description": "HTTP method."
    },
    "path": {
      "const": "/v1/engagements",
      "description": "Path template (versioned /v1)."
    },
    "headers": {
      "type": "object",
      "description": "Contract-relevant request headers (platform/transport headers are out of scope). correlation-id is optional from the UI (generated by ms-experience-gateway when missing, DISENO 3.8.5) and mandatory on service-to-service and operator calls (propagation, RF-120).",
      "properties": {
        "correlation-id": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
        },
        "traceparent": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/traceparent"
        },
        "accept": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/acceptJson"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "queryParams": {
      "type": "object",
      "description": "Filters of RF-033 (DISENO 3.3 (e), DEC-31): offerStatus and the offerSince range go into the GSI2 key condition; the others filter the GSI2 projection. All combinable.",
      "properties": {
        "offerStatus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "NONE",
              "PENDING",
              "APPLIED",
              "DECLINED",
              "WITHDRAWN",
              "SUPERSEDED",
              "APPLIED_WITHDRAWN"
            ]
          },
          "description": "Offer status filter, one or more values (repeated parameter); NONE = no offer. 'Up to date' = classification CLASSIFIED without PENDING (DEC-31)."
        },
        "classification": {
          "type": "string",
          "enum": [
            "UNCLASSIFIED",
            "CLASSIFIED"
          ],
          "description": "Filter by classification."
        },
        "templateId": {
          "type": "string",
          "format": "uuid",
          "description": "Filter by template (product)."
        },
        "branch": {
          "type": "string",
          "description": "Filter by market branch.",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Current (base) version label."
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Offer target version label."
        },
        "offerSinceFrom": {
          "type": "string",
          "format": "date-time",
          "description": "Pending since >= (inclusive)."
        },
        "offerSinceTo": {
          "type": "string",
          "format": "date-time",
          "description": "Pending since < (exclusive)."
        },
        "cursor": {
          "$ref": "../_shared/pagination.schema.json#/$defs/cursor"
        },
        "limit": {
          "$ref": "../_shared/pagination.schema.json#/$defs/limit"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "method",
    "path",
    "headers",
    "queryParams"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "method": "GET",
      "path": "/v1/engagements",
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
        "accept": "application/json"
      },
      "queryParams": {
        "templateId": "33333333-3333-4333-8333-333333333333",
        "limit": 50,
        "cursor": "eyJzIjpbIjEyIiwiMDQiXX0",
        "offerStatus": [
          "PENDING"
        ]
      }
    }
  ]
}
