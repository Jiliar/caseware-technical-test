{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-experience-gateway/getPendingUpdateDiff.request.schema.json",
  "title": "getPendingUpdateDiff request",
  "description": "GET /v1/engagements/{engagementId}/pending-update/diff - request. Full canonical diff of the pending offer (base -> target), paginated (RF-035; DESIGN_DOC 'next to the original diff').",
  "$comment": "Source: DISENO S7 (d) GetPendingUpdateDiffQuery, (e), 3.8.6 DiffPage, DEC-34; DISENO 4.8 SX-01b (S7 -> S2 GET /v1/summaries/{summaryId}/diff); PRD RF-035, RF-047. Audience: PUBLIC (UI via ms-experience-gateway). Residency: REGIONAL cell for the engagement lookup; the diff is global TEMPLATE_PUBLIC content. Idempotency: safe read (GET). Pagination: cursor + limit <= N_pagemax; the cursor encodes the last diff path served.",
  "type": "object",
  "properties": {
    "method": {
      "const": "GET",
      "description": "HTTP method."
    },
    "path": {
      "const": "/v1/engagements/{engagementId}/pending-update/diff",
      "description": "Path template (versioned /v1)."
    },
    "headers": {
      "type": "object",
      "description": "Contract-relevant request headers (platform/transport headers are out of scope). correlation-id is optional from the UI (generated by ms-experience-gateway when missing, DISENO 3.8.5) and mandatory on service-to-service and operator calls (propagation, RF-120).",
      "properties": {
        "correlation-id": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
        },
        "traceparent": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/traceparent"
        },
        "accept": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/acceptJson"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "pathParams": {
      "type": "object",
      "description": "Path parameters.",
      "properties": {
        "engagementId": {
          "type": "string",
          "format": "uuid",
          "description": "Engagement id."
        }
      },
      "required": [
        "engagementId"
      ],
      "additionalProperties": false
    },
    "queryParams": {
      "type": "object",
      "description": "Query parameters.",
      "properties": {
        "cursor": {
          "$ref": "../_shared/pagination.schema.json#/$defs/cursor"
        },
        "limit": {
          "$ref": "../_shared/pagination.schema.json#/$defs/limit"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "method",
    "path",
    "headers",
    "pathParams"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "method": "GET",
      "path": "/v1/engagements/{engagementId}/pending-update/diff",
      "headers": {
