{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-backfill-reconciler/startCampaign.request.schema.json",
  "title": "startCampaign request",
  "description": "POST /v1/campaigns - request. Starts a backfill campaign (BackfillSaga).",
  "$comment": "Source: DISENO S5 (b) BackfillCampaign, (c) campaign/firm_progress AP-D3, (d) StartCampaignUseCase/PauseCampaignUseCase, (e) operator APIs, (h); PRD RF-014, RF-083, RNF-035, SLO-06; US-02.2.1. Audience: OPERATOR (operator console / role-restricted). Residency: REGIONAL (cell); firmId stays in the cell. Idempotency: Idempotency-Key required: campaignId = UUID v5 of the key, so a repeated request returns the same campaign (DEC-35). Pagination: n/a.",
  "type": "object",
  "properties": {
    "method": {
      "const": "POST",
      "description": "HTTP method."
    },
    "path": {
      "const": "/v1/campaigns",
      "description": "Path template (versioned /v1)."
    },
    "headers": {
      "type": "object",
      "description": "Contract-relevant request headers (platform/transport headers are out of scope). correlation-id is optional from the UI (generated by ms-experience-gateway when missing, DISENO 3.8.5) and mandatory on service-to-service and operator calls (propagation, RF-120). idempotency-key is required on every write (DISENO 3.8.5, DEC-35).",
      "properties": {
        "correlation-id": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
        },
        "traceparent": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/traceparent"
        },
        "accept": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/acceptJson"
        },
        "content-type": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeJson"
        },
        "idempotency-key": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/idempotencyKey"
        }
      },
      "required": [
        "correlation-id",
        "content-type",
        "idempotency-key"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "description": "JSON request body.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CATALOG",
            "EXPORT"
          ],
          "description": "Discovery source: enumerable catalog (SUP-08) or metadata export (OQ-05)."
        },
        "quotaShare": {
          "type": "number",
          "minimum": 0,
          "description": "Share of the downstream quota (within B %)."
        },
        "valleyWindow": {
          "type": "string",
          "description": "Valley window.",
          "minLength": 1
        },
        "priorityPolicy": {
          "type": "string",
          "description": "Priority policy.",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "quotaShare",
        "valleyWindow",
        "priorityPolicy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "method",
    "path",
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "method": "POST",
      "path": "/v1/campaigns",
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
        "accept": "application/json",
        "content-type": "application/json",
        "idempotency-key": "5f0e8d1c-3b2a-4c4d-8e9f-0a1b2c3d4e5f"
      },
      "body": {
        "kind": "CATALOG",
        "quotaShare": 0.2,
        "valleyWindow": "22:00-06:00 local",
        "priorityPolicy": "MOST_ACTIVE_FIRST"
      }
    }
  ]
}
