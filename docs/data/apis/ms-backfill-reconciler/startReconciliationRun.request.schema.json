{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-backfill-reconciler/startReconciliationRun.request.schema.json",
  "title": "startReconciliationRun request",
  "description": "POST /v1/reconciliation-runs - request. Starts a TARGETED reconciliation run of a template, a firm or a list of engagements; the run emits RecomputeEngagementOffers.v1 and the targeted inspection (DISENO S5 (e), runbook 7.4 step 5).",
  "$comment": "Source: DISENO S5 (d) RunReconciliationUseCase, (e), (f), 4.4 CMD-07, 7.4 runbook step 5, DEC-25; PRD RF-083, RF-088. Audience: OPERATOR (operator console). Residency: REGIONAL (cell). Idempotency: Idempotency-Key required: runId = UUID v5 of the key, so a repeated request returns the same run (DEC-35). Pagination: n/a.",
  "type": "object",
  "properties": {
    "method": {
      "const": "POST",
      "description": "HTTP method."
    },
    "path": {
      "const": "/v1/reconciliation-runs",
      "description": "Path template (versioned /v1)."
    },
    "headers": {
      "type": "object",
      "description": "Contract-relevant request headers (platform/transport headers are out of scope). correlation-id is optional from the UI (generated by ms-experience-gateway when missing, DISENO 3.8.5) and mandatory on service-to-service and operator calls (propagation, RF-120). idempotency-key is required on every write (DISENO 3.8.5, DEC-35).",
      "properties": {
        "correlation-id": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
        },
        "traceparent": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/traceparent"
        },
        "accept": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/acceptJson"
        },
        "content-type": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeJson"
        },
        "idempotency-key": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/idempotencyKey"
        }
      },
      "required": [
        "correlation-id",
        "content-type",
        "idempotency-key"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "description": "Scope of the targeted run (scope TEMPLATE requires templateId, FIRM requires firmId, ENGAGEMENTS requires engagementIds).",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "TEMPLATE",
            "FIRM",
            "ENGAGEMENTS"
          ],
          "description": "Run scope."
        },
        "templateId": {
          "type": "string",
          "format": "uuid",
          "description": "Template to reconcile (scope TEMPLATE)."
        },
        "firmId": {
          "type": "string",
          "format": "uuid",
          "description": "Firm to reconcile (scope FIRM)."
        },
        "engagementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Engagements to reconcile (scope ENGAGEMENTS); at most L_lote."
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "TEMPLATE"
              }
            }
          },
          "then": {
            "required": [
              "templateId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "FIRM"
              }
            }
          },
          "then": {
            "required": [
              "firmId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "ENGAGEMENTS"
              }
            }
          },
          "then": {
            "required": [
              "engagementIds"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "method",
    "path",
    "headers",
    "body"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "method": "POST",
      "path": "/v1/reconciliation-runs",
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
        "accept": "application/json",
        "content-type": "application/json",
        "idempotency-key": "5f0e8d1c-3b2a-4c4d-8e9f-0a1b2c3d4e5f"
      },
      "body": {
        "scope": "TEMPLATE",
        "templateId": "33333333-3333-4333-8333-333333333333"
      }
    }
  ]
}
