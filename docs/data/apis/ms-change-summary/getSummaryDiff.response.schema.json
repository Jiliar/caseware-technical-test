{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-change-summary/getSummaryDiff.response.schema.json",
  "title": "getSummaryDiff response",
  "description": "GET /v1/summaries/{summaryId}/diff - responses per status code. Canonical diff behind a summary, paginated by diff path.",
  "$comment": "Source: DISENO S2 (e) '(+ /diff paginated by path)', (c) diffs/{diffHash}.json.gz claim-check, AP-S3; DISENO 4.8 SX-01b ('summary not available, see diff'); PRD RF-035, RF-047. Audience: INTERNAL service-to-service - SX-01b callee (degraded 'see diff'). Residency: GLOBAL (home region); TEMPLATE_PUBLIC content only, may be read cross-region; requests and responses never carry engagementId/firmId/userId (RF-056, RF-092). Idempotency: safe read (GET). Pagination: cursor + limit <= N_pagemax; the cursor encodes the last diff path served (DISENO 3.8.5).",
  "type": "object",
  "properties": {
    "status": {
      "type": "integer",
      "enum": [
        200,
        400,
        404
      ],
      "description": "HTTP status."
    },
    "headers": {
      "type": "object",
      "description": "Response headers (see the per-status subschema)."
    },
    "body": {
      "description": "Response body (see the per-status subschema)."
    }
  },
  "required": [
    "status",
    "headers"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "$ref": "#/$defs/status200"
    },
    {
      "$ref": "#/$defs/status400"
    },
    {
      "$ref": "#/$defs/status404"
    }
  ],
  "$defs": {
    "status200": {
      "type": "object",
      "description": "200: Page of the diff.",
      "properties": {
        "status": {
          "const": 200,
          "description": "Page of the diff."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeJson"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "$ref": "../_shared/DiffPage.schema.json"
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status400": {
      "type": "object",
      "description": "400: Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request).",
      "properties": {
        "status": {
          "const": 400,
          "description": "Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 400
                },
                "type": {
                  "enum": [
                    "invalid-request"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status404": {
      "type": "object",
      "description": "404: Summary not found, or summary-pending while it is being generated.",
      "properties": {
        "status": {
          "const": 404,
          "description": "Summary not found, or summary-pending while it is being generated."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 404
                },
                "type": {
                  "enum": [
                    "not-found",
                    "summary-pending"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "status": 200,
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "content-type": "application/json"
      },
      "body": {
        "summaryId": "55555555-5555-4555-8555-555555555555",
        "diffHash": "9f2c1e0b7a4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b",
        "items": [
          {
            "path": "/sections/planning/checklist/items/12",
            "changeType": "ADDED",
            "label": "Planning checklist - question 12",
            "after": {
              "text": "Have related-party disclosures been reviewed?"
            }
          }
        ],
        "nextCursor": "L3NlY3Rpb25zL3BsYW5uaW5n"
      }
    }
  ]
}
