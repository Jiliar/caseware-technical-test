{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-change-summary/reportSummary.request.schema.json",
  "title": "reportSummary request",
  "description": "POST /v1/summaries/{summaryId}/reports - request. Reports a summary as incorrect or unclear; creates a review case feeding the golden set.",
  "$comment": "Source: DISENO S2 (e) 'POST /v1/summaries/{summaryId}/reports (RF-059)'; PRD RF-059 (Could), RF-056. Audience: OPERATOR (content-team reviewers; S7 does not call it, DEC-32). Residency: GLOBAL (home region); TEMPLATE_PUBLIC content only, may be read cross-region; requests and responses never carry engagementId/firmId/userId (RF-056, RF-092); the report carries no user, firm or engagement identifiers. Idempotency: Idempotency-Key required: reportId = UUID v5 of the key, so a repeated request returns the same report (DEC-35). Pagination: n/a.",
  "type": "object",
  "properties": {
    "method": {
      "const": "POST",
      "description": "HTTP method."
    },
    "path": {
      "const": "/v1/summaries/{summaryId}/reports",
      "description": "Path template (versioned /v1)."
    },
    "headers": {
      "type": "object",
      "description": "Contract-relevant request headers (platform/transport headers are out of scope). correlation-id is optional from the UI (generated by ms-experience-gateway when missing, DISENO 3.8.5) and mandatory on service-to-service and operator calls (propagation, RF-120). idempotency-key is required on every write (DISENO 3.8.5, DEC-35).",
      "properties": {
        "correlation-id": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
        },
        "traceparent": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/traceparent"
        },
        "accept": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/acceptJson"
        },
        "content-type": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeJson"
        },
        "idempotency-key": {
          "$ref": "../_shared/common-headers.schema.json#/$defs/idempotencyKey"
        }
      },
      "required": [
        "correlation-id",
        "content-type",
        "idempotency-key"
      ],
      "additionalProperties": false
    },
    "pathParams": {
      "type": "object",
      "description": "Path parameters.",
      "properties": {
        "summaryId": {
          "type": "string",
          "format": "uuid",
          "description": "Summary id."
        }
      },
      "required": [
        "summaryId"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "description": "JSON request body.",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "INCORRECT",
            "UNCLEAR"
          ],
          "description": "Report reason (RF-059 'incorrect/unclear'; values derived)."
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "method",
    "path",
    "headers",
    "pathParams",
    "body"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "method": "POST",
      "path": "/v1/summaries/{summaryId}/reports",
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
        "accept": "application/json",
        "content-type": "application/json",
        "idempotency-key": "5f0e8d1c-3b2a-4c4d-8e9f-0a1b2c3d4e5f"
      },
      "pathParams": {
        "summaryId": "55555555-5555-4555-8555-555555555555"
      },
      "body": {
        "reason": "UNCLEAR"
      }
    }
  ]
}
