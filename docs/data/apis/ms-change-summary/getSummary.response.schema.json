            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "$ref": "../_shared/SummaryRecord.schema.json"
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status404": {
      "type": "object",
      "description": "404: Resource not found (problem type not-found).",
      "properties": {
        "status": {
          "const": 404,
          "description": "Resource not found (problem type not-found)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 404
                },
                "type": {
                  "enum": [
                    "not-found"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    }
  },
