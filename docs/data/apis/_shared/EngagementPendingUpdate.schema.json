{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/_shared/EngagementPendingUpdate.schema.json",
  "title": "EngagementPendingUpdate",
  "description": "Offer state of one engagement as served by ms-engagement-index (state part of PendingUpdateView).",
  "$comment": "Source: DISENO S3 (e) GET /v1/engagements/{engagementId}/pending-update, AP-I1, S3 (b), 3.8.6 (view model EngagementPendingUpdate); PRD RF-035, RF-050. Audience: internal (S3 -> S7, SX-01a family). Residency: regional.",
  "type": "object",
  "properties": {
    "engagementId": {
      "type": "string",
      "format": "uuid",
      "description": "Engagement id."
    },
    "firmId": {
      "type": "string",
      "format": "uuid",
      "description": "Firm id (tenant)."
    },
    "templateId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Template id; null while UNCLASSIFIED and unknown."
    },
    "branch": {
      "type": [
        "string",
        "null"
      ],
      "description": "Market branch; null while UNCLASSIFIED."
    },
    "currentVersion": {
      "type": [
        "string",
        "null"
      ],
      "description": "Real base version label; null while UNCLASSIFIED."
    },
    "classification": {
      "type": "string",
      "enum": [
        "UNCLASSIFIED",
        "CLASSIFIED"
      ],
      "description": "Classification (engagement_state.state without ARCHIVED; archived engagements are not listed, RF-010 'active' scope). UNCLASSIFIED must be rendered as 'verifying' (RF-015)."
    },
    "offer": {
      "oneOf": [
        {
          "$ref": "Offer.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Current offer, null when there is none."
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "APPLIED_WITHDRAWN"
        ]
      },
      "description": "Flags (DISENO S3 (b); RF-073).",
      "uniqueItems": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update of the projection item (freshness, RF-037)."
    },
    "declineHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "declinedVersion": {
            "type": "string",
            "description": "Declined version label.",
            "minLength": 1
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User who declined."
          },
          "summaryId": {
            "type": "string",
            "format": "uuid",
            "description": "Summary shown when declining."
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Decision instant."
          }
        },
        "required": [
          "declinedVersion",
          "userId",
          "summaryId",
          "decidedAt"
        ],
        "additionalProperties": false
      },
      "description": "DeclineRecord list: annotation/audit only, never filters eligibility (DEC-21). Bounded by the versions published for the template."
    },
    "intermediateVersions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Published, non-withdrawn versions of the engagement's branch that descend from the base and are ancestors of the offer target, in templateSeq order; empty without offer. Basis of the per-version breakdown (RF-050, DISENO 3.8.6, DEC-34)."
    }
  },
  "required": [
    "engagementId",
    "firmId",
    "templateId",
    "branch",
    "currentVersion",
    "classification",
    "offer",
    "flags",
    "updatedAt",
    "declineHistory",
    "intermediateVersions"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "engagementId": "11111111-1111-4111-8111-111111111111",
      "firmId": "22222222-2222-4222-8222-222222222222",
      "templateId": "33333333-3333-4333-8333-333333333333",
      "branch": "main",
      "currentVersion": "v3",
      "classification": "CLASSIFIED",
      "offer": {
        "target": "v7",
        "since": "2026-10-22T10:00:05Z",
        "status": "PENDING",
        "previouslyDeclined": [
          "v5"
        ]
      },
      "flags": [],
      "updatedAt": "2026-10-22T10:00:05Z",
      "declineHistory": [
        {
          "declinedVersion": "v5",
          "userId": "44444444-4444-4444-8444-444444444444",
          "summaryId": "56565656-5656-4565-8565-565656565656",
          "decidedAt": "2026-09-15T14:00:00Z"
        }
      ],
      "intermediateVersions": [
        "v4",
        "v5"
      ]
    }
  ]
}
