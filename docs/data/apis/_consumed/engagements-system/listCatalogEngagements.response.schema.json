      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status503": {
      "type": "object",
      "description": "503: Transient failure (5xx/timeout/throttling): retried with backoff up to N_reint; circuit breaker counts it.",
      "properties": {
        "status": {
          "const": 503,
          "description": "Transient failure (5xx/timeout/throttling): retried with backoff up to N_reint; circuit breaker counts it."
        },
        "headers": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "body": {
          "description": "Error body defined by the owning team (unknown)."
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
