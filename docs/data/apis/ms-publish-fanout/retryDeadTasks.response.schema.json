{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/apis/ms-publish-fanout/retryDeadTasks.response.schema.json",
  "title": "retryDeadTasks response",
  "description": "POST /v1/jobs/{jobId}/dead-tasks:retry - responses per status code. Re-enqueues dead/failed tasks of a job after fixing the cause (REST equivalent of RetryFanOutTasks.v1).",
  "$comment": "Source: DISENO S4 (b), (d) StartFanOutUseCase/CancelFanOutUseCase/FanOutStatusQuery, (e) operator APIs (RF-121), AP-F6, AP-F7; PRD RF-121, RF-022; US-08.2.1; DISENO 4.4 CMD-06 RetryFanOutTasks.v1; 4.5 (g); 7.4 runbook; RF-107, RF-085; US-08.2.2. Audience: OPERATOR (operator console / role-restricted). Residency: REGIONAL (cell); job view is OPERATIONAL (counters, no engagement ids). Idempotency: Idempotency-Key required and used as requestId (fanout_job.lastRetryRequestId); runs the same use case as RetryFanOutTasks.v1 and sends no message (DEC-24). Pagination: n/a.",
  "type": "object",
  "properties": {
    "status": {
      "type": "integer",
      "enum": [
        202,
        400,
        404,
        409
      ],
      "description": "HTTP status."
    },
    "headers": {
      "type": "object",
      "description": "Response headers (see the per-status subschema)."
    },
    "body": {
      "description": "Response body (see the per-status subschema)."
    }
  },
  "required": [
    "status",
    "headers"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "$ref": "#/$defs/status202"
    },
    {
      "$ref": "#/$defs/status400"
    },
    {
      "$ref": "#/$defs/status404"
    },
    {
      "$ref": "#/$defs/status409"
    }
  ],
  "$defs": {
    "status202": {
      "type": "object",
      "description": "202: Accepted: retry command enqueued.",
      "properties": {
        "status": {
          "const": 202,
          "description": "Accepted: retry command enqueued."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeJson"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "description": "RetryAccepted (DISENO 3.8.6).",
          "properties": {
            "jobId": {
              "type": "string",
              "format": "uuid",
              "description": "Job id."
            },
            "requestId": {
              "type": "string",
              "format": "uuid",
              "description": "= Idempotency-Key of the request."
            },
            "failureReasons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "RETRIES_EXHAUSTED",
                  "NON_RETRYABLE"
                ]
              },
              "description": "Which FAILED tasks to retry, by failureReason; absent = all FAILED tasks."
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum number of tasks to move FAILED -> PENDING."
            }
          },
          "required": [
            "jobId",
            "requestId",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status400": {
      "type": "object",
      "description": "400: Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request).",
      "properties": {
        "status": {
          "const": 400,
          "description": "Invalid request: parameters or body, missing Idempotency-Key, limit > N_pagemax or a foreign cursor (problem type invalid-request)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 400
                },
                "type": {
                  "enum": [
                    "invalid-request"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status404": {
      "type": "object",
      "description": "404: Resource not found (problem type not-found).",
      "properties": {
        "status": {
          "const": 404,
          "description": "Resource not found (problem type not-found)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 404
                },
                "type": {
                  "enum": [
                    "not-found"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    "status409": {
      "type": "object",
      "description": "409: Conflict: transition not allowed from the current state (invalid-state) or Idempotency-Key reused with another body (idempotency-key-reuse).",
      "properties": {
        "status": {
          "const": 409,
          "description": "Conflict: transition not allowed from the current state (invalid-state) or Idempotency-Key reused with another body (idempotency-key-reuse)."
        },
        "headers": {
          "type": "object",
          "properties": {
            "correlation-id": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/correlationId"
            },
            "content-type": {
              "$ref": "../_shared/common-headers.schema.json#/$defs/contentTypeProblem"
            }
          },
          "required": [
            "correlation-id",
            "content-type"
          ],
          "additionalProperties": false
        },
        "body": {
          "allOf": [
            {
              "$ref": "../_shared/problem-details.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": 409
                },
                "type": {
                  "enum": [
                    "invalid-state",
                    "idempotency-key-reuse"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "status": 202,
      "headers": {
        "correlation-id": "99999999-9999-4999-8999-999999999999",
        "content-type": "application/json"
      },
      "body": {
        "jobId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
        "requestId": "5f0e8d1c-3b2a-4c4d-8e9f-0a1b2c3d4e5f",
        "failureReasons": [
          "RETRIES_EXHAUSTED"
        ],
        "max": 100
      }
    }
  ]
}
