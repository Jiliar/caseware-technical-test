{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/events/EngagementClassificationRequired.v1.schema.json",
  "title": "EngagementClassificationRequired.v1",
  "description": "Batch of discovered engagements that are still UNCLASSIFIED and need an inspection (backfill saga step).",
  "$comment": "Source: DISENO 4.3 catalog EV-14; RF-014, RF-015. Producer: ms-engagement-index. Consumers: ms-backfill-reconciler. Channel: SNS ms-engagement-index -> SQS ms-backfill-reconciler. Ordering/partition key: engagementId. Idempotency key: eventId. Guarantee: at-least-once. Versioning: additive within v1 (DISENO 4.2). dataClass: ENGAGEMENT_REGIONAL (DISENO 4.3). Stays inside the firm's cell; may carry engagement, firm or user identifiers but never workpaper content.",
  "x-catalogId": "EV-14",
  "x-messageKind": "EVENT",
  "x-dataClass": "ENGAGEMENT_REGIONAL",
  "x-crossRegion": false,
  "x-producers": [
    "ms-engagement-index"
  ],
  "x-consumers": [
    "ms-backfill-reconciler"
  ],
  "x-channel": "SNS ms-engagement-index -> SQS ms-backfill-reconciler",
  "x-snsTopic": "{cell}-ms-engagement-index-events",
  "x-sqsQueues": [
    "{cell}-ms-backfill-reconciler-ms-engagement-index"
  ],
  "x-orderingKey": "engagementId",
  "x-idempotencyKey": "eventId",
  "x-deliveryGuarantee": "at-least-once",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "EngagementClassificationRequired"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "EVENT"
    },
    "producer": {
      "const": "ms-engagement-index"
    },
    "payload": {
      "type": "object",
      "properties": {
        "campaignId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Backfill campaign id, when the batch belongs to a campaign."
        },
        "runId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Reconciliation run of the originating discovery batch, when it came from a run (DEC-26)."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "Unclassified engagements (batch); minItems 1: an empty batch is never emitted.",
          "items": {
            "type": "object",
            "properties": {
              "engagementId": {
                "$ref": "envelope.schema.json#/$defs/uuid",
                "description": "Engagement id."
              },
              "firmId": {
                "$ref": "envelope.schema.json#/$defs/uuid",
                "description": "Firm id."
              },
              "templateId": {
                "$ref": "envelope.schema.json#/$defs/uuid",
                "description": "Template id, if known."
              }
            },
            "required": [
              "engagementId",
              "firmId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "eventId": "e0000000-0000-4000-8000-000000000014",
      "eventType": "EngagementClassificationRequired",
      "schemaVersion": 1,
      "occurredAt": "2026-10-22T10:00:01Z",
      "producer": "ms-engagement-index",
      "correlationId": "99999999-9999-4999-8999-999999999999",
      "causationId": "c0000000-0000-4000-8000-000000000014",
      "cellId": "eu",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "kind": "EVENT",
      "payload": {
        "campaignId": "77777777-7777-4777-8777-777777777777",
        "items": [
          {
            "engagementId": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
            "firmId": "22222222-2222-4222-8222-222222222222",
            "templateId": "33333333-3333-4333-8333-333333333333"
          }
        ]
      }
    }
  ]
}
