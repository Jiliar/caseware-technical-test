{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/events/ChangeSummaryInvalidated.v1.schema.json",
  "title": "ChangeSummaryInvalidated.v1",
  "description": "A summary was invalidated because a version it covers was withdrawn (row in summary_invalidation; the record itself is never edited, INV-05).",
  "$comment": "Source: DISENO 4.3 catalog EV-07; RF-071; US-06.2.3. Producer: ms-change-summary. Consumers: ms-experience-gateway, ms-audit-ledger. Channel: global EventBridge bus -> cell EventBridge buses (whitelist) -> one rule per consumer -> SQS. Ordering/partition key: summaryId. Idempotency key: summaryId + withdrawnVersion. Guarantee: at-least-once. Versioning: additive within v1 (DISENO 4.2). dataClass: TEMPLATE_PUBLIC (DISENO 4.3). Crosses regions (whitelisted in the EventBridge rules); must not contain engagementId, firmId, userId or free text (contract test, DISENO 4.1).",
  "x-catalogId": "EV-07",
  "x-messageKind": "EVENT",
  "x-dataClass": "TEMPLATE_PUBLIC",
  "x-crossRegion": true,
  "x-producers": [
    "ms-change-summary"
  ],
  "x-consumers": [
    "ms-experience-gateway",
    "ms-audit-ledger"
  ],
  "x-channel": "global EventBridge bus -> cell EventBridge buses (whitelist) -> one rule per consumer -> SQS",
  "x-snsTopic": null,
  "x-sqsQueues": [
    "{cell}-ms-experience-gateway-ms-change-summary",
    "{cell}-ms-audit-ledger-ms-change-summary"
  ],
  "x-orderingKey": "summaryId",
  "x-idempotencyKey": "summaryId + withdrawnVersion",
  "x-deliveryGuarantee": "at-least-once",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ChangeSummaryInvalidated"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "EVENT"
    },
    "producer": {
      "const": "ms-change-summary"
    },
    "payload": {
      "type": "object",
      "properties": {
        "summaryId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Invalidated summary id."
        },
        "templateId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Template id."
        },
        "withdrawnVersion": {
          "$ref": "envelope.schema.json#/$defs/versionLabel",
          "description": "Withdrawn version that caused the invalidation."
        },
        "invalidatedAt": {
          "$ref": "envelope.schema.json#/$defs/instant",
          "description": "Invalidation instant."
        }
      },
      "required": [
        "summaryId",
        "templateId",
        "withdrawnVersion",
        "invalidatedAt"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "eventId": "e0000000-0000-4000-8000-000000000007",
      "eventType": "ChangeSummaryInvalidated",
      "schemaVersion": 1,
      "occurredAt": "2026-10-22T10:00:01Z",
      "producer": "ms-change-summary",
      "correlationId": "99999999-9999-4999-8999-999999999999",
      "causationId": "c0000000-0000-4000-8000-000000000007",
      "cellId": "global",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "kind": "EVENT",
      "payload": {
        "summaryId": "55555555-5555-4555-8555-555555555555",
        "templateId": "33333333-3333-4333-8333-333333333333",
        "withdrawnVersion": "v6",
        "invalidatedAt": "2026-10-22T11:00:30Z"
      }
    }
  ]
}
