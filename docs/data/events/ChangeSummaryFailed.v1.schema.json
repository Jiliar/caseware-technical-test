{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/events/ChangeSummaryFailed.v1.schema.json",
  "title": "ChangeSummaryFailed.v1",
  "description": "Summary generation failed for a SummaryKey (e.g. comparator unavailable, SX-05); a deferred retry is scheduled at retryAt.",
  "$comment": "Source: DISENO 4.3 catalog EV-06; RF-044; US-05.1.4. Producer: ms-change-summary. Consumers: ms-experience-gateway. Channel: global EventBridge bus -> cell EventBridge buses (whitelist) -> one rule per consumer -> SQS. Ordering/partition key: summaryKey (templateId, from, to, locale). Idempotency key: eventId. Guarantee: at-least-once. Versioning: additive within v1 (DISENO 4.2). dataClass: TEMPLATE_PUBLIC (DISENO 4.3). Crosses regions (whitelisted in the EventBridge rules); must not contain engagementId, firmId, userId or free text (contract test, DISENO 4.1).",
  "x-catalogId": "EV-06",
  "x-messageKind": "EVENT",
  "x-dataClass": "TEMPLATE_PUBLIC",
  "x-crossRegion": true,
  "x-producers": [
    "ms-change-summary"
  ],
  "x-consumers": [
    "ms-experience-gateway"
  ],
  "x-channel": "global EventBridge bus -> cell EventBridge buses (whitelist) -> one rule per consumer -> SQS",
  "x-snsTopic": null,
  "x-sqsQueues": [
    "{cell}-ms-experience-gateway-ms-change-summary"
  ],
  "x-orderingKey": "summaryKey (templateId, from, to, locale)",
  "x-idempotencyKey": "eventId",
  "x-deliveryGuarantee": "at-least-once",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ChangeSummaryFailed"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "EVENT"
    },
    "producer": {
      "const": "ms-change-summary"
    },
    "payload": {
      "type": "object",
      "properties": {
        "templateId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Template id."
        },
        "from": {
          "$ref": "envelope.schema.json#/$defs/versionLabel",
          "description": "Source version label."
        },
        "to": {
          "$ref": "envelope.schema.json#/$defs/versionLabel",
          "description": "Target version label."
        },
        "locale": {
          "type": "string",
          "description": "Locale."
        },
        "failureCode": {
          "type": "string",
          "enum": [
            "COMPARATOR_UNAVAILABLE",
            "COMPARATOR_ERROR"
          ],
          "description": "Why no summary could be produced: the comparator was unavailable (transient, retried at retryAt) or rejected the pair (permanent). LLM failures never produce this event: the deterministic layer is the fallback (RF-044)."
        },
        "retryAt": {
          "$ref": "envelope.schema.json#/$defs/instant",
          "description": "Instant of the deferred retry."
        }
      },
      "required": [
        "templateId",
        "from",
        "to",
        "locale",
        "failureCode",
        "retryAt"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "eventId": "e0000000-0000-4000-8000-000000000006",
      "eventType": "ChangeSummaryFailed",
      "schemaVersion": 1,
      "occurredAt": "2026-10-22T10:00:01Z",
      "producer": "ms-change-summary",
      "correlationId": "99999999-9999-4999-8999-999999999999",
      "causationId": "c0000000-0000-4000-8000-000000000006",
      "cellId": "global",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "kind": "EVENT",
      "payload": {
        "templateId": "33333333-3333-4333-8333-333333333333",
        "from": "v3",
        "to": "v7",
        "locale": "en-CA",
        "failureCode": "COMPARATOR_UNAVAILABLE",
        "retryAt": "2026-10-22T10:15:00Z"
      }
    }
  ]
}
