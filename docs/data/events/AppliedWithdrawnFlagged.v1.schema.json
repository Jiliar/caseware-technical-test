{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/events/AppliedWithdrawnFlagged.v1.schema.json",
  "title": "AppliedWithdrawnFlagged.v1",
  "description": "An engagement had already applied a version that is now withdrawn: flag APPLIED_WITHDRAWN (nothing is reverted, the user is notified).",
  "$comment": "Source: DISENO 4.3 catalog EV-21; RF-073; US-06.2.4. Producer: ms-engagement-index. Consumers: ms-experience-gateway, ms-audit-ledger. Channel: SNS ms-engagement-index -> SQS (ms-experience-gateway, ms-audit-ledger). Ordering/partition key: engagementId. Idempotency key: eventId. Guarantee: at-least-once. Versioning: additive within v1 (DISENO 4.2). dataClass: ENGAGEMENT_REGIONAL (DISENO 4.3). Stays inside the firm's cell; may carry engagement, firm or user identifiers but never workpaper content.",
  "x-catalogId": "EV-21",
  "x-messageKind": "EVENT",
  "x-dataClass": "ENGAGEMENT_REGIONAL",
  "x-crossRegion": false,
  "x-producers": [
    "ms-engagement-index"
  ],
  "x-consumers": [
    "ms-experience-gateway",
    "ms-audit-ledger"
  ],
  "x-channel": "SNS ms-engagement-index -> SQS (ms-experience-gateway, ms-audit-ledger)",
  "x-snsTopic": "{cell}-ms-engagement-index-events",
  "x-sqsQueues": [
    "{cell}-ms-experience-gateway-ms-engagement-index",
    "{cell}-ms-audit-ledger-ms-engagement-index"
  ],
  "x-orderingKey": "engagementId",
  "x-idempotencyKey": "eventId",
  "x-deliveryGuarantee": "at-least-once",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "AppliedWithdrawnFlagged"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "EVENT"
    },
    "producer": {
      "const": "ms-engagement-index"
    },
    "payload": {
      "type": "object",
      "properties": {
        "engagementId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Engagement id."
        },
        "firmId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Firm id."
        },
        "templateId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Template id."
        },
        "withdrawnVersion": {
          "$ref": "envelope.schema.json#/$defs/versionLabel",
          "description": "Applied version that was withdrawn."
        },
        "occurredAt": {
          "$ref": "envelope.schema.json#/$defs/instant",
          "description": "Instant of the flagging."
        }
      },
      "required": [
        "engagementId",
        "firmId",
        "templateId",
        "withdrawnVersion",
        "occurredAt"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "eventId": "e0000000-0000-4000-8000-000000000021",
      "eventType": "AppliedWithdrawnFlagged",
      "schemaVersion": 1,
      "occurredAt": "2026-10-22T10:00:01Z",
      "producer": "ms-engagement-index",
      "correlationId": "99999999-9999-4999-8999-999999999999",
      "causationId": "c0000000-0000-4000-8000-000000000021",
      "cellId": "eu",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "kind": "EVENT",
      "payload": {
        "engagementId": "11111111-1111-4111-8111-111111111111",
        "firmId": "22222222-2222-4222-8222-222222222222",
        "templateId": "33333333-3333-4333-8333-333333333333",
        "withdrawnVersion": "v6",
        "occurredAt": "2026-10-22T11:00:10Z"
      }
    }
  ]
}
