{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/events/ProjectionDriftDetected.v1.schema.json",
  "title": "ProjectionDriftDetected.v1",
  "description": "The projected version of an engagement differed from the observed one (reconciliation or lazy discovery); records whether it was repaired.",
  "$comment": "Source: DISENO 4.3 catalog EV-24; RF-016, RF-082, RF-083, RF-088. Producer: ms-engagement-index. Consumers: ms-backfill-reconciler. Channel: SNS ms-engagement-index -> SQS ms-backfill-reconciler. Ordering/partition key: engagementId. Idempotency key: eventId. Guarantee: at-least-once. Versioning: additive within v1 (DISENO 4.2). dataClass: ENGAGEMENT_REGIONAL (DISENO 4.3). Stays inside the firm's cell; may carry engagement, firm or user identifiers but never workpaper content.",
  "x-catalogId": "EV-24",
  "x-messageKind": "EVENT",
  "x-dataClass": "ENGAGEMENT_REGIONAL",
  "x-crossRegion": false,
  "x-producers": [
    "ms-engagement-index"
  ],
  "x-consumers": [
    "ms-backfill-reconciler"
  ],
  "x-channel": "SNS ms-engagement-index -> SQS ms-backfill-reconciler",
  "x-snsTopic": "{cell}-ms-engagement-index-events",
  "x-sqsQueues": [
    "{cell}-ms-backfill-reconciler-ms-engagement-index"
  ],
  "x-orderingKey": "engagementId",
  "x-idempotencyKey": "eventId",
  "x-deliveryGuarantee": "at-least-once",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ProjectionDriftDetected"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "EVENT"
    },
    "producer": {
      "const": "ms-engagement-index"
    },
    "payload": {
      "type": "object",
      "properties": {
        "engagementId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Engagement id."
        },
        "firmId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Firm id."
        },
        "source": {
          "type": "string",
          "enum": [
            "INSPECTED",
            "EXPORT",
            "OBSERVED"
          ],
          "description": "Where the observed version came from: EngagementVersionInspected (INSPECTED), a metadata export (EXPORT) or EngagementTemplateObserved (OBSERVED)."
        },
        "projectedVersion": {
          "$ref": "envelope.schema.json#/$defs/versionLabel",
          "description": "Version held by the projection."
        },
        "observedVersion": {
          "$ref": "envelope.schema.json#/$defs/versionLabel",
          "description": "Version observed in reality."
        },
        "repaired": {
          "type": "boolean",
          "description": "Whether the projection was repaired."
        },
        "detectedAt": {
          "$ref": "envelope.schema.json#/$defs/instant",
          "description": "Detection instant."
        }
      },
      "required": [
        "engagementId",
        "firmId",
        "source",
        "projectedVersion",
        "observedVersion",
        "repaired",
        "detectedAt"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "eventId": "e0000000-0000-4000-8000-000000000024",
      "eventType": "ProjectionDriftDetected",
      "schemaVersion": 1,
      "occurredAt": "2026-10-22T10:00:01Z",
      "producer": "ms-engagement-index",
      "correlationId": "99999999-9999-4999-8999-999999999999",
      "causationId": "c0000000-0000-4000-8000-000000000024",
      "cellId": "eu",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "kind": "EVENT",
      "payload": {
        "engagementId": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
        "firmId": "22222222-2222-4222-8222-222222222222",
        "source": "INSPECTED",
        "projectedVersion": "v3",
        "observedVersion": "v5",
        "repaired": true,
        "detectedAt": "2026-10-22T03:00:00Z"
      }
    }
  ]
}
