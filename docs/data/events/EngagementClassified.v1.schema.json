{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseware.invalid/docs/en/data/events/EngagementClassified.v1.schema.json",
  "title": "EngagementClassified.v1",
  "description": "An engagement moved to CLASSIFIED (known base version); measures backfill coverage.",
  "$comment": "Source: DISENO 4.3 catalog EV-16; RF-014; SLO-06. Producer: ms-engagement-index. Consumers: ms-backfill-reconciler. Channel: SNS ms-engagement-index -> SQS ms-backfill-reconciler. Ordering/partition key: engagementId. Idempotency key: eventId. Guarantee: at-least-once. Versioning: additive within v1 (DISENO 4.2). dataClass: ENGAGEMENT_REGIONAL (DISENO 4.3). Stays inside the firm's cell; may carry engagement, firm or user identifiers but never workpaper content.",
  "x-catalogId": "EV-16",
  "x-messageKind": "EVENT",
  "x-dataClass": "ENGAGEMENT_REGIONAL",
  "x-crossRegion": false,
  "x-producers": [
    "ms-engagement-index"
  ],
  "x-consumers": [
    "ms-backfill-reconciler"
  ],
  "x-channel": "SNS ms-engagement-index -> SQS ms-backfill-reconciler",
  "x-snsTopic": "{cell}-ms-engagement-index-events",
  "x-sqsQueues": [
    "{cell}-ms-backfill-reconciler-ms-engagement-index"
  ],
  "x-orderingKey": "engagementId",
  "x-idempotencyKey": "eventId",
  "x-deliveryGuarantee": "at-least-once",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "EngagementClassified"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "EVENT"
    },
    "producer": {
      "const": "ms-engagement-index"
    },
    "payload": {
      "type": "object",
      "properties": {
        "engagementId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Engagement id."
        },
        "firmId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Firm id."
        },
        "campaignId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Backfill campaign id, if the classification belongs to a campaign."
        },
        "runId": {
          "$ref": "envelope.schema.json#/$defs/uuid",
          "description": "Reconciliation run of the originating discovery batch, when it came from a run (DEC-26)."
        },
        "source": {
          "type": "string",
          "enum": [
            "CREATED",
            "DECISION",
            "OBSERVED",
            "INSPECTED",
            "EXPORT"
          ],
          "description": "What classified it: EngagementCreated (CREATED), an apply/decline hook (DECISION), EngagementTemplateObserved (OBSERVED), EngagementVersionInspected (INSPECTED) or an EngagementDiscovered item with assertedVersion (EXPORT)."
        },
        "classifiedAt": {
          "$ref": "envelope.schema.json#/$defs/instant",
          "description": "Classification instant."
        }
      },
      "required": [
        "engagementId",
        "firmId",
        "source",
        "classifiedAt"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "eventId": "e0000000-0000-4000-8000-000000000016",
      "eventType": "EngagementClassified",
      "schemaVersion": 1,
      "occurredAt": "2026-10-22T10:00:01Z",
      "producer": "ms-engagement-index",
      "correlationId": "99999999-9999-4999-8999-999999999999",
      "causationId": "c0000000-0000-4000-8000-000000000016",
      "cellId": "eu",
      "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "kind": "EVENT",
      "payload": {
        "engagementId": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
        "firmId": "22222222-2222-4222-8222-222222222222",
        "campaignId": "77777777-7777-4777-8777-777777777777",
        "source": "INSPECTED",
        "classifiedAt": "2026-10-22T02:10:02Z"
      }
    }
  ]
}
